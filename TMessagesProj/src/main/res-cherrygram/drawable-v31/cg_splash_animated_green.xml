<?xml version="1.0" encoding="utf-8"?>
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="splash"
            android:width="320dp"
            android:height="320dp"
            android:viewportWidth="320"
            android:viewportHeight="320">
            <group
                android:name="scaleme"
                android:pivotX="160"
                android:pivotY="160">
                <group
                    android:scaleX="2.5"
                    android:scaleY="2.5"
                    android:translateX="-80"
                    android:translateY="-80">
                    <clip-path android:pathData="M32 96a64 64 0 1 0 128 0a64 64 0 1 0-128 0z"/>
                    <path
                        android:pathData="M0 0H192V192H0z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="96"
                                android:startY="0"
                                android:endX="96"
                                android:endY="192">
                                <item
                                    android:color="#FF3DB296"
                                    android:offset="0"/>
                                <item
                                    android:color="#FF267A7A"
                                    android:offset="0.72"/>
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
                <path
                    android:fillType="evenOdd"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M 157.49 59.51 C 178.56 59.51 195.66 76.61 195.66 97.69 C 195.66 118.76 178.56 135.86 157.49 135.86 C 136.42 135.86 119.32 118.76 119.32 97.69 C 119.32 76.61 136.42 59.51 157.49 59.51 Z M 134.03 77.41 L 147.87 77.41 L 157.49 99.95 L 167.11 77.41 L 180.95 77.41 L 180.95 119.55 L 170.65 119.55 L 170.65 88.74 L 160.95 111.44 L 154.07 111.44 L 144.37 88.74 L 144.37 119.55 L 134.03 119.55 Z M 206.20 144.60 L 108.78 189.85 L 143.57 203.05 L 206.20 144.60 Z M 206.20 144.60 L 147.27 206.31 L 154.23 238.32 C 155.42 241.11 159.36 241.11 160.51 238.08 L 206.20 144.60 Z"/>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="scaleme">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="@integer/splash_screen_duration"
                    android:valueFrom="0.0"
                    android:valueTo="0.60"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_extra_slow_in"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="@integer/splash_screen_duration"
                    android:valueFrom="0.0"
                    android:valueTo="0.60"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_extra_slow_in"/>
                <objectAnimator
                    android:propertyName="alpha"
                    android:duration="@integer/splash_screen_duration"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_extra_slow_in"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
