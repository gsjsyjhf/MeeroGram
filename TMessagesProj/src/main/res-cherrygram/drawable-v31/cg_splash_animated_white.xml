                    android:scaleX="4.5267"
                    android:scaleY="4.5267"
                    android:translateX="-80.584"
                    android:translateY="-84.435">
                    <path
        android:fillType="evenOdd"
                        android:pathData="M 52.60 31.85 C 57.25 31.85 61.02 35.62 61.02 40.26 C 61.02 44.91 57.25 48.68 52.60 48.68 C 47.96 48.68 44.19 44.91 44.19 40.26 C 44.19 35.62 47.96 31.85 52.60 31.85 Z M 47.43 35.79 L 50.48 35.79 L 52.60 40.76 L 54.73 35.79 L 57.78 35.79 L 57.78 45.08 L 55.51 45.08 L 55.51 38.29 L 53.37 43.30 L 51.85 43.30 L 49.71 38.29 L 49.71 45.08 L 47.43 45.08 Z M 63.34 50.61 L 41.87 60.58 L 49.54 63.49 L 63.34 50.61 Z M 63.34 50.61 L 50.35 64.21 L 51.89 71.26 C 52.15 71.88 53.02 71.88 53.27 71.21 L 63.34 50.61 Z">
